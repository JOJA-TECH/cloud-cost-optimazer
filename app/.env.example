# ---------------------------------------------------------------------------
# Copy to .env (never commit) for local runs or reference.
# On the VM, cloud-init generates this file with mode 0600.
# ---------------------------------------------------------------------------

# --- Experiment identity ---
EXPERIMENT_UID=00000000-0000-0000-0000-000000000000
RUN_ENVIRONMENT=local

# --- Azure SQL (system under test) ---
AZURE_SQL_SERVER=your-server.database.windows.net
AZURE_SQL_DATABASE=loadtest
AZURE_SQL_PORT=1433
AZURE_SQL_ADMIN_USER=cco_sql_admin
AZURE_SQL_ADMIN_PASSWORD=REPLACE-ME
AZURE_SQL_USER=cco_workload
AZURE_SQL_PASSWORD=REPLACE-ME
AZURE_SQL_DRIVER=ODBC Driver 18 for SQL Server
AZURE_SQL_ENCRYPT=yes
AZURE_SQL_TRUST_SERVER_CERTIFICATE=no

# --- Supabase (analytical persistence) ---
SUPABASE_DB_HOST=db.xxxxxxxxxxxxxxxx.supabase.co
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=REPLACE-ME
SUPABASE_DB_SSLMODE=require

# --- Telegram ---
TELEGRAM_BOT_TOKEN=123456:REPLACE-ME
TELEGRAM_ALLOWED_CHAT_IDS=123456789

# --- Capture cadence and experiment lifecycle ---
CAPTURE_RAW_INTERVAL_SECONDS=60
OPERATIONAL_AGGREGATION_MINUTES=5
FEATURE_PERIOD=1h
FORECAST_HORIZON=1h
EXPERIMENT_DURATION_HOURS=336
MAX_EXPERIMENT_HOURS=336
AUTO_STOP_AFTER_HOURS=360
FINAL_FLUSH_TIMEOUT_SECONDS=120

# --- Spool / retries ---
SUPABASE_RETRY_MAX_ATTEMPTS=8
SUPABASE_RETRY_BASE_SECONDS=5
LOCAL_SPOOL_MAX_MB=500
LOCAL_SPOOL_DIR=spool

# --- Safety ---
AUTO_START=false
MAX_STORAGE_PERCENT=80

# --- Azure control plane (for Azure Monitor reads via managed identity) ---
AZURE_SQL_RESOURCE_ID=
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=
AZURE_LOCATION=