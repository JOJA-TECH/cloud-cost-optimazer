#cloud-config
# ---------------------------------------------------------------------------
# Cloud-init for the Cloud Cost Optimizer collector VM.
#
# It prepares the runtime (Python, msodbcsql18, git), writes the experiment
# configuration and the systemd units, installs the Python dependencies and
# applies the database migrations (Azure SQL + Supabase) as one-shot units.
#
# The application code lives in the repository; if app_git_repo_url is set the
# VM clones it. Otherwise copy app/ to ${app_dir}/app via scp.
# ---------------------------------------------------------------------------
package_update: true
package_upgrade: false

packages:
  - python3
  - python3-pip
  - python3-venv
  - git
  - curl
  - ca-certificates
  - gnupg
  - unixodbc
  - unixodbc-dev
  - netcat-openbsd
  - jq

write_files:
  - path: ${app_dir}/.env
    owner: root:root
    permissions: '0600'
    content: |
      # Generated by Terraform cloud-init. Do not commit.
      EXPERIMENT_UID=${experiment_uid}
      RUN_ENVIRONMENT=azure-vm

      # --- Azure SQL (system under test) ---
      AZURE_SQL_SERVER=${azure_sql_server}
      AZURE_SQL_DATABASE=${azure_sql_database}
      AZURE_SQL_PORT=1433
      AZURE_SQL_ADMIN_USER=${azure_sql_admin_user}
      AZURE_SQL_ADMIN_PASSWORD=${azure_sql_admin_password}
      AZURE_SQL_USER=${azure_sql_user}
      AZURE_SQL_PASSWORD=${azure_sql_password}
      AZURE_SQL_DRIVER=ODBC Driver 18 for SQL Server
      AZURE_SQL_ENCRYPT=yes
      AZURE_SQL_TRUST_SERVER_CERTIFICATE=no

      # --- Supabase (analytical persistence) ---
      SUPABASE_DB_HOST=${supabase_db_host}
      SUPABASE_DB_PORT=${supabase_db_port}
      SUPABASE_DB_NAME=${supabase_db_name}
      SUPABASE_DB_USER=${supabase_db_user}
      SUPABASE_DB_PASSWORD=${supabase_db_password}
      SUPABASE_DB_SSLMODE=require

      # --- Telegram ---
      TELEGRAM_BOT_TOKEN=${telegram_bot_token}
      TELEGRAM_ALLOWED_CHAT_IDS=${telegram_chat_ids}

      # --- Capture cadence and experiment lifecycle ---
      CAPTURE_RAW_INTERVAL_SECONDS=${capture_interval_seconds}
      OPERATIONAL_AGGREGATION_MINUTES=5
      FEATURE_PERIOD=1h
      FORECAST_HORIZON=1h
      EXPERIMENT_DURATION_HOURS=${experiment_duration_hours}
      MAX_EXPERIMENT_HOURS=${max_experiment_hours}
      AUTO_STOP_AFTER_HOURS=${auto_stop_after_hours}
      FINAL_FLUSH_TIMEOUT_SECONDS=120

      # --- Spool / retries ---
      SUPABASE_RETRY_MAX_ATTEMPTS=8
      SUPABASE_RETRY_BASE_SECONDS=5
      LOCAL_SPOOL_MAX_MB=500
      LOCAL_SPOOL_DIR=${app_dir}/spool

      # --- Safety ---
      AUTO_START=false
      MAX_STORAGE_PERCENT=80

      # --- Workload load control ---
      WORKLOAD_INTENSITY=0.7
      WORKLOAD_INTENSITY_JITTER=0.0

      # --- Azure control plane (Azure Monitor reads via managed identity) ---
      AZURE_SQL_RESOURCE_ID=${azure_sql_resource_id}
      AZURE_SUBSCRIPTION_ID=${azure_subscription_id}
      AZURE_RESOURCE_GROUP=${azure_resource_group}
      AZURE_LOCATION=${azure_location}
      AZURE_SQL_MAX_SIZE_GB=${azure_sql_max_size_gb}

  - path: /etc/systemd/system/cco-migrate.service
    owner: root:root
    permissions: '0644'
    content: |
      [Unit]
      Description=CCO database migrations (Azure SQL + Supabase)
      After=network-online.target
      Wants=network-online.target

      [Service]
      Type=oneshot
      RemainAfterExit=yes
      WorkingDirectory=${app_dir}/app
      EnvironmentFile=${app_dir}/.env
      ExecStart=/bin/bash -c 'if [ -x ${app_dir}/venv/bin/python ] && [ -d ${app_dir}/app/src ]; then ${app_dir}/venv/bin/python -m src.migrations --apply; else echo "app not present yet; skipping migrations"; fi'
      TimeoutStartSec=600

      [Install]
      WantedBy=multi-user.target

  - path: /etc/systemd/system/cco-workload.service
    owner: root:root
    permissions: '0644'
    content: |
      [Unit]
      Description=CCO workload generator
      After=network-online.target cco-migrate.service
      Wants=network-online.target
      Requires=cco-migrate.service

      [Service]
      Type=simple
      WorkingDirectory=${app_dir}/app
      EnvironmentFile=${app_dir}/.env
      ExecStart=${app_dir}/venv/bin/python -m src.workload.runner --service
      Restart=on-failure
      RestartSec=10
      TimeoutStopSec=180
      MemoryMax=320M
      # Do not restart a workload that was stopped on purpose.
      ExecCondition=/bin/bash -c 'grep -q "^AUTO_START=true" ${app_dir}/.env'

      [Install]
      WantedBy=multi-user.target

  - path: /etc/systemd/system/cco-collector.service
    owner: root:root
    permissions: '0644'
    content: |
      [Unit]
      Description=CCO metric collector and sync
      After=network-online.target cco-migrate.service
      Wants=network-online.target
      Requires=cco-migrate.service

      [Service]
      Type=simple
      WorkingDirectory=${app_dir}/app
      EnvironmentFile=${app_dir}/.env
      ExecStart=${app_dir}/venv/bin/python -m src.metrics.collector --service
      Restart=on-failure
      RestartSec=10
      TimeoutStopSec=180
      MemoryMax=256M

      [Install]
      WantedBy=multi-user.target

  - path: /etc/systemd/system/cco-telegram-bot.service
    owner: root:root
    permissions: '0644'
    content: |
      [Unit]
      Description=CCO Telegram control bot (long polling)
      After=network-online.target cco-collector.service
      Wants=network-online.target cco-collector.service

      [Service]
      Type=simple
      WorkingDirectory=${app_dir}/app
      EnvironmentFile=${app_dir}/.env
      ExecStart=${app_dir}/venv/bin/python -m src.telegram.bot --service
      Restart=on-failure
      RestartSec=10
      TimeoutStopSec=200
      MemoryMax=192M

      [Install]
      WantedBy=multi-user.target

  - path: /etc/systemd/system/cco-supervisor.service
    owner: root:root
    permissions: '0644'
    content: |
      [Unit]
      Description=CCO experiment watchdog (auto-stop safety net)
      After=network-online.target cco-collector.service
      Wants=network-online.target cco-collector.service

      [Service]
      Type=simple
      WorkingDirectory=${app_dir}/app
      EnvironmentFile=${app_dir}/.env
      ExecStart=${app_dir}/venv/bin/python -m src.shutdown --supervise
      Restart=on-failure
      RestartSec=30
      TimeoutStopSec=200
      MemoryMax=128M

      [Install]
      WantedBy=multi-user.target

runcmd:
  - [bash, -lc, "install -d -m 0755 ${app_dir}"]
  - [bash, -lc, "install -d -m 0700 ${app_dir}/spool"]
  - [bash, -lc, "curl -fsSL https://packages.microsoft.com/keys/microsoft.asc | gpg --dearmor -o /usr/share/keyrings/microsoft-prod.gpg"]
  # Write the repo file explicitly with signed-by so apt trusts the keyring above
  # (the upstream prod.list omits it and apt then fails with NO_PUBKEY).
  - [bash, -lc, "echo 'deb [arch=amd64,arm64,armhf signed-by=/usr/share/keyrings/microsoft-prod.gpg] https://packages.microsoft.com/ubuntu/22.04/prod jammy main' > /etc/apt/sources.list.d/mssql-release.list"]
  - [bash, -lc, "apt-get update"]
  - [bash, -lc, "ACCEPT_EULA=Y DEBIAN_FRONTEND=noninteractive apt-get install -y msodbcsql18"]
  - [bash, -lc, "python3 -m venv ${app_dir}/venv"]
  - [bash, -lc, "if [ -n '${app_git_repo_url}' ]; then if [ ! -d ${app_dir}/app/.git ]; then git clone --depth 1 --branch '${app_git_ref}' '${app_git_repo_url}' ${app_dir}/app; fi; else echo 'app_git_repo_url empty: copy app/ to ${app_dir}/app manually'; fi"]
  - [bash, -lc, "if [ -f ${app_dir}/app/requirements.txt ]; then ${app_dir}/venv/bin/pip install --upgrade pip && ${app_dir}/venv/bin/pip install -r ${app_dir}/app/requirements.txt; fi"]
  - [bash, -lc, "chown -R root:root ${app_dir}/app 2>/dev/null || true"]
  - [bash, -lc, "systemctl daemon-reload"]
  - [bash, -lc, "systemctl enable cco-migrate.service cco-collector.service cco-telegram-bot.service cco-supervisor.service"]
  - [bash, -lc, "systemctl start cco-migrate.service || true"]
  - [bash, -lc, "systemctl start cco-collector.service cco-telegram-bot.service cco-supervisor.service"]
  - [bash, -lc, "if grep -q '^AUTO_START=true' ${app_dir}/.env; then systemctl start cco-workload.service; else echo 'AUTO_START=false: workload not started (use Telegram /start)'; fi"]

final_message: "CCO collector VM ready. Control the experiment with the Telegram bot. AUTO_START is false by default."
