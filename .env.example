# =============================================================================
# Local forecasting environment (docker compose).
# Copy to `.env` and adjust. `.env` is git-ignored: never commit real values.
# =============================================================================

# --- Local PostgreSQL (docker) ----------------------------------------------
POSTGRES_DB=cco_forecasting
POSTGRES_USER=cco_forecasting
POSTGRES_PASSWORD=CHANGE_ME_local_only
POSTGRES_PORT=55432

# --- Local application DSN --------------------------------------------------
# Overridden by scripts/ that assemble the DSN from the POSTGRES_* values.
LOCAL_DSN=postgresql://cco_forecasting:CHANGE_ME_local_only@127.0.0.1:55432/cco_forecasting

# --- Source database (read-only copy of the real telemetry) -----------------
# The source holds the real collected metrics. It is NEVER written to and
# NEVER used to train: it is only read to build the local working copy.
SOURCE_DSN=
SOURCE_SSLMODE=require
SOURCE_EXPERIMENT_UID=

# --- Experiment identity of the real run ------------------------------------
EXPERIMENT_UID=

# --- Reproducibility --------------------------------------------------------
RANDOM_SEED=42

# --- Source resource under observation ---------------------------------------
# Stable identifier of the observed Azure SQL database (from the source DB).
RESOURCE_UID=
RESOURCE_NAME=cco-lab-sql-database
RESOURCE_SKU_CODE=
RESOURCE_COMPUTE_MODEL=
RESOURCE_VCORES=
RESOURCE_REGION_CODE=australiaeast
RESOURCE_PROVIDER=azure
